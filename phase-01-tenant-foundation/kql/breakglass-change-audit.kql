// Changes to break-glass accounts or their exclusion group
// Purpose : Detect tampering: password resets, method changes, role removal, or someone
//           being added to GRP-CA-Exclude-BreakGlass (which would exempt them from all CA).
// Replace the GUIDs with the break-glass ObjectIds and the exclusion group ID.
let WatchedIds = dynamic(["978d7f0e-53e4-4519-9709-f924d1dc06a6", "e8cf4021-b81f-43c3-b992-06edadc30940", "9452ed74-4932-47cd-ac63-3137827bb7b9"]);
AuditLogs
| where TimeGenerated > ago(1d)
| mv-expand Target = TargetResources
| where tostring(Target.id) in (WatchedIds)
| project TimeGenerated, OperationName, Result,
          Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
          Target = tostring(Target.displayName), CorrelationId
