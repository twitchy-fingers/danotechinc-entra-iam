# Copy to %USERPROFILE%\danotech-secrets\expenses.env (OUTSIDE the repository) and fill in.
# Never commit the real file.
TENANT_ID=danotechinc.onmicrosoft.com
CLIENT_ID=<Application (client) ID from the app registration Overview>
CLIENT_SECRET=<secret Value, copied once when created>
FLASK_SECRET_KEY=<run: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))>
